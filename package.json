{
	"name": "@cairncms/directus-extension-formatter",
	"description": "Normalize and format field values in Flows",
	"icon": "transform",
	"version": "0.1.0",
	"license": "GPL-3.0-only",
	"author": "The CairnCMS Authors",
	"repository": {
		"type": "git",
		"url": "https://github.com/CairnCMS/directus-extension-formatter.git"
	},
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-operation"
	],
	"type": "module",
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"directus:extension": {
		"type": "operation",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"source": {
			"app": "src/app.ts",
			"api": "src/api.ts"
		},
		"host": "^11.0.0 || ^12.0.0",
		"sandbox": {
			"enabled": true,
			"requestedScopes": {}
		}
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "18.0.6",
		"@sindresorhus/slugify": "2.2.1",
		"@types/big.js": "^6.2.2",
		"@types/node": "^22.19.17",
		"big.js": "6.2.2",
		"joi": "17.13.8",
		"libphonenumber-js": "1.13.15",
		"typescript": "5.6.3",
		"vitest": "^3.2.0",
		"vue": "^3.5.44"
	}
}
